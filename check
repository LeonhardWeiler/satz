#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
stage=${1-all}
if [ "$stage" != e2e ]; then
  ! grep -rnE '(^|\s)(//|/\*)(\s|$)' engine/src web/src web/e2e web/*.ts web/*.js --include=*.rs --include=*.ts --include=*.tsx --include=*.js --include=*.css --exclude-dir=engine || { echo "comments are not allowed" >&2; exit 1; }
  cargo fmt --check
  cargo clippy --all-targets -- -D warnings
  cargo test
  wasm-pack build engine --target web --out-dir ../web/src/engine --no-pack
  size=$(stat -c %s web/src/engine/engine_bg.wasm)
  [ "$size" -le "${WASM_BUDGET:-13300000}" ] || { echo "engine_bg.wasm is $size bytes, over the budget of ${WASM_BUDGET:-13300000}" >&2; exit 1; }
fi
cd web
[ pnpm-lock.yaml -nt node_modules/.modules.yaml ] && pnpm install --frozen-lockfile
if [ "$stage" != e2e ]; then
  pnpm exec tsc --noEmit
  pnpm lint
  pnpm test
  pnpm build
fi
if [ "$stage" != build ]; then
  export PORT=${PORT:-$(node -e "const s=require('net').createServer().listen(0,()=>{console.log(s.address().port);s.close()})")}
  pnpm e2e "${@:2}"
fi
